{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnePieceSim",
  "version": "0.1.0",
  "identifier": "dev.onepiecesim.desktop",
  "build": {
    "frontendDist": "../../client"
  },
  "app": {
    "windows": [
      {
        "title": "One Piece Card Game",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}